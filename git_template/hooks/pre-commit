#!/bin/bash

FILES_PATTERN='\.(js|coffee|haml|erb|rb|exs|ex|json|yml)(\..+)?$'

FORBIDDEN=(
  " debugger"
  "binding\.pry"
  "byebug"
  ">>>>>>"
  "<<<<<<"
  "save_and_open_page"
  "require\ 'pry'"
  "require\ \"pry\""
  "IEx\.pry"
  "require\ IEx"
)

set -euo pipefail

FORBIDDEN_FOUND=

if [[ -z ${THIS_IS_FINE:-} ]]; then
  for i in "${FORBIDDEN[@]}"
  do
    git diff --cached --diff-filter=ACMR --name-only | grep -E $FILES_PATTERN | \
        GREP_COLORS='4;5;37;41' xargs grep --color --with-filename -n "$i" \
      && echo -e 'Debugger code found:' $i '- please remove before committing' \
      && echo -e 'if you are sure the code is okay, e.g. a comment, then use this:' \
      && echo -e "\n  THIS_IS_FINE=true git commit ...\n" \
      && FORBIDDEN_FOUND=true
  done
else
  echo "Skipping pre-commit check for debugging code."
fi

# Check if we're in the gravity repo and run mix phx.digest.clean --all
REPO_NAME=$(basename "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null || echo "")
if [[ "$REPO_NAME" == "gravity" ]]; then
  # Check if any files in priv/static have changed
  STATIC_FILES_CHANGED=$(git diff --cached --name-only | grep "^priv/static/" || true)

  if [[ -n "$STATIC_FILES_CHANGED" ]]; then
    echo "Static files changed, running mix phx.digest.clean --all in gravity repo..."
    if command -v mix &> /dev/null; then
      mix phx.digest.clean --all
      git add priv/static/
    else
      echo "Warning: mix command not found, skipping digest clean"
    fi
  else
    echo "No static files changed, skipping digest clean"
  fi
fi

# returns 0 (true) if $FORBIDDEN_FOUND is empty
[[ -z $FORBIDDEN_FOUND ]]
